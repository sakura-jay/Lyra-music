* text=auto eol=lf

*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.pro text eol=lf
*.xml text eol=lf
*.md text eol=lf diff=markdown
*.json text eol=lf

# 包装脚本：gradlew 必须是 LF，否则 Windows 上签出的 CRLF 会让 Gradle Wrapper 跑不起来
gradlew text eol=lf
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

*.png binary
*.webp binary
*.jpg binary
*.jar binary
*.aar binary
*.so binary
*.apk binary
*.aab binary
*.ttf binary
*.otf binary
